{
	"alias": {
		"@zsnout/ithkuil/scripts/jsx-runtime": "@zsnout/ithkuil/jsx-runtime"
	},
	"compilerOptions": {
		"skipLibCheck": true,
		"target": "esnext",
		"module": "NodeNext",
		"moduleResolution": "NodeNext",
		"esModuleInterop": true,
		"resolveJsonModule": true,
		"types": ["node"],
		"noImplicitAny": false,
		"removeComments": true,
		"preserveConstEnums": true,
		"sourceMap": false,
		"noImplicitReturns": true,
        "outDir": "dist"
	},
	"strict": true,
	"declaration": true,
	"include": [
        "src/**/*.ts"
	]
}
