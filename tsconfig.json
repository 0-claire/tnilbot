{
  "alias": {
    "@zsnout/ithkuil/script": "@zsnout/ithkuil/script/index.ts"
  },
  "compilerOptions": {
    "skipLibCheck": true,
    "target": "esnext",
    "module": "nodenext",
    // "moduleResolution": "NodeNext",
    "moduleResolution": "bundler",
    "moduleDetection": "force",
    "resolveJsonModule": true,
    "types": ["node"],
    "noImplicitAny": false,
    "removeComments": true,
    "preserveConstEnums": true,
    "sourceMap": false,
    "noImplicitReturns": true,
    "outDir": "dist",
    "strict": true
  },
  "declaration": true,
  "include": [
        "src/**/*.ts"
  ]
}
